{
  "name": "dejareview",
  "displayName": "DejaReview",
  "description": "Review code locally, then copy contextual feedback into any AI tool.",
  "version": "0.1.0",
  "publisher": "local-review",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "scripts": {
    "compile": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "test": "npm run compile && node --test out/test/*.test.js",
    "test:integration": "npm run compile && node out/test/runIntegration.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.9.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "dejareview.addComment",
        "title": "Add Review Note",
        "category": "DejaReview"
      },
      {
        "command": "dejareview.submitComment",
        "title": "Add Review Note",
        "category": "DejaReview",
        "enablement": "!commentIsEmpty && !dejareview.copyInProgress"
      },
      {
        "command": "dejareview.editComment",
        "title": "Edit Review Note",
        "icon": "$(edit)",
        "category": "DejaReview"
      },
      {
        "command": "dejareview.saveComment",
        "title": "Save",
        "category": "DejaReview"
      },
      {
        "command": "dejareview.cancelEdit",
        "title": "Cancel",
        "category": "DejaReview"
      },
      {
        "command": "dejareview.deleteComment",
        "title": "Delete Review Note",
        "icon": "$(trash)",
        "category": "DejaReview"
      },
      {
        "command": "dejareview.cancelDraft",
        "title": "Cancel",
        "category": "DejaReview"
      },
      {
        "command": "dejareview.reveal",
        "title": "Reveal in REVIEW-NOTES.md",
        "icon": "$(go-to-file)",
        "category": "DejaReview"
      },
      {
        "command": "dejareview.gotoCode",
        "title": "Go to Code",
        "category": "DejaReview"
      },
      {
        "command": "dejareview.openComparison",
        "title": "Open Side-by-Side Comparison",
        "icon": "$(diff)",
        "category": "DejaReview"
      },
      {
        "command": "dejareview.copyForAgent",
        "title": "Copy Review Notes & Clear",
        "icon": "$(copy)",
        "category": "DejaReview",
        "enablement": "dejareview.hasFeedback && !dejareview.copyInProgress"
      },
      {
        "command": "dejareview.restoreArchive",
        "title": "Recover Archived Review",
        "category": "DejaReview"
      },
      {
        "command": "dejareview.refresh",
        "title": "Refresh Review Notes",
        "icon": "$(refresh)",
        "category": "DejaReview"
      },
      {
        "command": "dejareview.reanchorAll",
        "title": "Rewrite Line Numbers from Anchors",
        "category": "DejaReview"
      },
      {
        "command": "dejareview.suggestGitignore",
        "title": "Add REVIEW-NOTES.md to .gitignore",
        "category": "DejaReview"
      }
    ],
    "keybindings": [
      {
        "command": "dejareview.addComment",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dejareview.addComment",
          "when": "resourceScheme == file || resourceScheme == git",
          "group": "dejareview@1"
        }
      ],
      "view/title": [
        {
          "command": "dejareview.copyForAgent",
          "when": "view == dejareview.tree && dejareview.hasFeedback",
          "group": "navigation@1"
        },
        {
          "command": "dejareview.refresh",
          "when": "view == dejareview.tree",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "dejareview.reveal",
          "when": "view == dejareview.tree && viewItem == reviewComment",
          "group": "inline@1"
        },
        {
          "command": "dejareview.deleteComment",
          "when": "view == dejareview.tree && viewItem == reviewComment",
          "group": "inline@2"
        },
        {
          "command": "dejareview.openComparison",
          "when": "view == dejareview.tree && viewItem == reviewComment",
          "group": "navigation"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "dejareview.submitComment",
          "when": "commentController == dejareview && commentThreadIsEmpty",
          "group": "inline@1"
        },
        {
          "command": "dejareview.cancelDraft",
          "when": "commentController == dejareview && commentThreadIsEmpty",
          "group": "inline@2"
        }
      ],
      "comments/comment/title": [
        {
          "command": "dejareview.editComment",
          "when": "commentController == dejareview && comment == saved",
          "group": "inline@1"
        },
        {
          "command": "dejareview.deleteComment",
          "when": "commentController == dejareview && comment == saved",
          "group": "inline@2"
        },
        {
          "command": "dejareview.reveal",
          "when": "commentController == dejareview",
          "group": "inline@3"
        }
      ],
      "comments/comment/context": [
        {
          "command": "dejareview.saveComment",
          "when": "commentController == dejareview && comment == editing",
          "group": "inline@1"
        },
        {
          "command": "dejareview.cancelEdit",
          "when": "commentController == dejareview && comment == editing",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "dejareview.openComparison",
          "when": "commentController == dejareview && commentThread == comparison",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "dejareview.submitComment",
          "when": "false"
        },
        {
          "command": "dejareview.saveComment",
          "when": "false"
        },
        {
          "command": "dejareview.cancelEdit",
          "when": "false"
        },
        {
          "command": "dejareview.cancelDraft",
          "when": "false"
        },
        {
          "command": "dejareview.editComment",
          "when": "false"
        },
        {
          "command": "dejareview.deleteComment",
          "when": "false"
        },
        {
          "command": "dejareview.reveal",
          "when": "false"
        },
        {
          "command": "dejareview.gotoCode",
          "when": "false"
        },
        {
          "command": "dejareview.openComparison",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dejareview",
          "title": "DejaReview",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "dejareview": [
        {
          "id": "dejareview.dashboard",
          "name": "Review",
          "type": "webview",
          "initialSize": 2
        },
        {
          "id": "dejareview.tree",
          "name": "Review Notes",
          "initialSize": 3
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dejareview.tree",
        "contents": "Add review notes using the gutter or [Add Review Note](command:dejareview.addComment).\nWhen ready, use Copy Review Notes & Clear and paste into your AI tool.",
        "when": "!dejareview.hasFeedback"
      }
    ],
    "configuration": {
      "title": "DejaReview",
      "properties": {
        "dejareview.decorationStyle": {
          "type": "string",
          "enum": [
            "badge",
            "none"
          ],
          "default": "badge",
          "description": "Supplement native review note gutters with compact badges."
        },
        "dejareview.searchRadius": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "maximum": 10000,
          "description": "Local search radius when relocating review note anchors."
        }
      }
    }
  }
}
